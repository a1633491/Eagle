{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eagle-server-worker",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
        "vars": {
                "ROBINHOOD_RPC_URL": "https://robinhood.drpc.org",
                "ROBINHOOD_FACTORY_ADDRESS": "0xA1821b220716cE0bADb708Cd7A507D791f83437a",
                "ROBINHOOD_FACTORY_START_BLOCK": "61867248",
                "ROBINHOOD_WETH_ADDRESS": "0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73",
                "ROBINHOOD_STABLE_TOKEN_ADDRESS": "0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168",
                "ROBINHOOD_STABLE_SYMBOL": "USDG",
                "UNISWAP_ROUTER_VERSION": "2.2.0",
                "EAGLE_SYNC_BLOCK_WINDOW": "5000",
                "EAGLE_SYNC_CHUNK_SIZE": "100",
                "EAGLE_SYNC_MAX_CHUNKS_PER_RUN": "1",
                "TOKEN_SYNC_COOLDOWN_MS": "10000"
        },
        "triggers": {
                "crons": [
                        "*/2 * * * *"
                ]
        },
	"observability": {
		"enabled": true
	},
        "d1_databases": [
                {
                        "binding": "TOKEN_STORAGE_DB",
                        "database_name": "eagle-token-storage",
                        "database_id": "43e97f18-31c5-4ab1-be28-d2ff14fb76d7"
                }
        ],
	"kv_namespaces": [
		{
			"binding": "TOKEN_STORAGE_KV",
			"id": "2d9c29ad12b047ffb7046f81c712b869"
		}
        ],
        "r2_buckets": [
                {
                        "binding": "TOKEN_IMAGE_BUCKET",
                        "bucket_name": "eagle-token-images"
                }
	]
}
